  "warp_remaining_reset_profile": {
    "scope": "native CUDA diagnostic on one free body, no contacts; transfer counts include zero-width calls; excludes startup; no baseline speedup claim",
    "command": "uv run --no-sync python /tmp/m2-warp-reset-profile.py",
    "source": "import json\nimport statistics\nimport tempfile\nimport time\nfrom pathlib import Path\n\nimport numpy as np\nfrom unisim.backend.mjwarp.backend import MjwarpBackend\nfrom unisim.scene import SceneCfg\n\nresults = []\nwith tempfile.TemporaryDirectory() as directory:\n    source = Path(directory) / 'model.xml'\n    source.write_text('<mujoco><option gravity=\"0 0 0\"/><worldbody><body name=\"base\"><freejoint/><geom name=\"g\" size=\".1\" contype=\"0\" conaffinity=\"0\"/></body></worldbody></mujoco>')\n    for n in (2, 512):\n        backend = MjwarpBackend(SceneCfg(model_file=str(source)), n, .002, base_name='base', nconmax=8, njmax=16)\n        try:\n            backend.step(np.zeros((n, 0)), nsteps=1)\n            upload = backend._upload\n            counts = []\n            def counted(target, values):\n                counts.append(values.nbytes)\n                upload(target, values)\n            backend._upload = counted\n            for count in (1, n):\n                rows = np.arange(count)\n                state = backend.get_state(('qpos', 'qvel'))\n                qpos, qvel = state['qpos'][rows], state['qvel'][rows]\n                elapsed = []\n                for iteration in range(5):\n                    counts.clear()\n                    started = time.perf_counter()\n                    backend.set_state(rows, qpos, qvel)\n                    elapsed.append((time.perf_counter()-started)*1000)\n                results.append({'N':n, 'selected':count, 'median_ms':statistics.median(elapsed[1:]), 'upload_calls':len(counts), 'upload_bytes':sum(counts), 'download_persistent_bytes':sum(getattr(backend._device_data, field).numpy().nbytes for field in ('ctrl','act','qfrc_applied','xfrc_applied','qacc_warmstart'))})\n        finally:\n            backend.close()\nPath('/tmp/m2-warp-reset-profile.json').write_text(json.dumps(results,indent=2))\nprint(json.dumps(results,indent=2))\n",
    "gpu": "NVIDIA GeForce RTX 4090, driver 595.84",
